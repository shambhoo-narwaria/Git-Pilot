{
  "name": "aigit",
  "version": "1.0.0",
  "description": "AI-powered Git workflow automation — ship your code in one command",
  "main": "dist/index.js",
  "bin": {
    "aigit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!/usr/bin/env node')){fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);}\"",
    "dev": "ts-node --esm src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["git", "cli", "automation", "developer-tools", "gitpilot"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.4.2",
    "ora": "^9.4.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.6.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
